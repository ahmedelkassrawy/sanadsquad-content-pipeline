{
  "$defs": {
    "MarketingFormat": {
      "additionalProperties": false,
      "description": "One data-loaded shape a marketing slot may use.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "units": {
          "$ref": "#/$defs/Units"
        },
        "link_rule": {
          "enum": [
            "required",
            "forbidden",
            "optional"
          ],
          "title": "Link Rule",
          "type": "string"
        },
        "length_hint": {
          "minLength": 1,
          "title": "Length Hint",
          "type": "string"
        },
        "numbering": {
          "default": false,
          "title": "Numbering",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "units",
        "link_rule",
        "length_hint"
      ],
      "title": "MarketingFormat",
      "type": "object"
    },
    "ResearchConfig": {
      "additionalProperties": false,
      "properties": {
        "hints": {
          "title": "Hints",
          "type": "string"
        },
        "topic_source": {
          "enum": [
            "kb",
            "angles"
          ],
          "title": "Topic Source",
          "type": "string"
        },
        "angles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angles"
        }
      },
      "required": [
        "hints",
        "topic_source"
      ],
      "title": "ResearchConfig",
      "type": "object"
    },
    "ReviewConfig": {
      "additionalProperties": false,
      "properties": {
        "pass_avg": {
          "maximum": 5,
          "minimum": 1,
          "title": "Pass Avg",
          "type": "number"
        },
        "min_score": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Min Score",
          "type": "number"
        },
        "hard_fail": {
          "items": {
            "type": "string"
          },
          "title": "Hard Fail",
          "type": "array"
        }
      },
      "required": [
        "pass_avg",
        "hard_fail"
      ],
      "title": "ReviewConfig",
      "type": "object"
    },
    "Units": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "minimum": 1,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "minimum": 1,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "Units",
      "type": "object"
    },
    "VisualConfig": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "title": "Template",
          "type": "string"
        },
        "severity_badge": {
          "enum": [
            "auto",
            "never"
          ],
          "title": "Severity Badge",
          "type": "string"
        }
      },
      "required": [
        "template",
        "severity_badge"
      ],
      "title": "VisualConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "writer": {
      "title": "Writer",
      "type": "string"
    },
    "rubric": {
      "title": "Rubric",
      "type": "string"
    },
    "units": {
      "$ref": "#/$defs/Units"
    },
    "numbering": {
      "title": "Numbering",
      "type": "boolean"
    },
    "research": {
      "$ref": "#/$defs/ResearchConfig"
    },
    "review": {
      "$ref": "#/$defs/ReviewConfig"
    },
    "visual": {
      "$ref": "#/$defs/VisualConfig"
    },
    "claim_words": {
      "items": {
        "type": "string"
      },
      "title": "Claim Words",
      "type": "array"
    },
    "max_approved_stats": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Approved Stats"
    },
    "max_brand_mentions": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Brand Mentions"
    },
    "hook_styles": {
      "items": {
        "type": "string"
      },
      "title": "Hook Styles",
      "type": "array"
    },
    "closing_styles": {
      "items": {
        "type": "string"
      },
      "title": "Closing Styles",
      "type": "array"
    },
    "formats": {
      "items": {
        "$ref": "#/$defs/MarketingFormat"
      },
      "title": "Formats",
      "type": "array"
    },
    "format_order": {
      "items": {
        "type": "string"
      },
      "title": "Format Order",
      "type": "array"
    },
    "weekly_topic_similarity": {
      "default": 0.6,
      "maximum": 1,
      "minimum": 0,
      "title": "Weekly Topic Similarity",
      "type": "number"
    }
  },
  "required": [
    "name",
    "writer",
    "rubric",
    "units",
    "numbering",
    "research",
    "review",
    "visual"
  ],
  "title": "PostType",
  "type": "object"
}
