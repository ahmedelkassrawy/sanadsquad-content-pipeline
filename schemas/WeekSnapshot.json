{
  "$defs": {
    "AgentUsage": {
      "additionalProperties": false,
      "description": "Model calls of one agent, summed from usage.jsonl. The uncertain part is included.",
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "uncertain_tokens": {
          "minimum": 0,
          "title": "Uncertain Tokens",
          "type": "integer"
        },
        "uncertain_cost_usd": {
          "title": "Uncertain Cost Usd",
          "type": "number"
        }
      },
      "required": [
        "calls",
        "tokens",
        "cost_usd",
        "uncertain_tokens",
        "uncertain_cost_usd"
      ],
      "title": "AgentUsage",
      "type": "object"
    },
    "AuditTweet": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "source_ids"
      ],
      "title": "AuditTweet",
      "type": "object"
    },
    "Draft": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "tweets": {
          "items": {
            "$ref": "#/$defs/Tweet"
          },
          "minItems": 1,
          "title": "Tweets",
          "type": "array"
        }
      },
      "required": [
        "slot_id",
        "tweets"
      ],
      "title": "Draft",
      "type": "object"
    },
    "DraftAudit": {
      "additionalProperties": false,
      "properties": {
        "original": {
          "$ref": "#/$defs/Draft"
        },
        "normalized": {
          "items": {
            "$ref": "#/$defs/AuditTweet"
          },
          "title": "Normalized",
          "type": "array"
        },
        "fixes": {
          "items": {
            "type": "string"
          },
          "title": "Fixes",
          "type": "array"
        },
        "violations": {
          "items": {
            "type": "string"
          },
          "title": "Violations",
          "type": "array"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "sentence_length_stats": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence Length Stats"
        }
      },
      "required": [
        "original",
        "normalized",
        "fixes",
        "violations",
        "accepted"
      ],
      "title": "DraftAudit",
      "type": "object"
    },
    "ExternalUsage": {
      "additionalProperties": false,
      "properties": {
        "search_calls": {
          "default": 0,
          "title": "Search Calls",
          "type": "integer"
        },
        "tavily_calls": {
          "default": 0,
          "title": "Tavily Calls",
          "type": "integer"
        },
        "ddgs_calls": {
          "default": 0,
          "title": "Ddgs Calls",
          "type": "integer"
        },
        "fetch_calls": {
          "default": 0,
          "title": "Fetch Calls",
          "type": "integer"
        },
        "tavily_credits": {
          "default": 0,
          "title": "Tavily Credits",
          "type": "number"
        },
        "tavily_credits_estimated": {
          "default": false,
          "title": "Tavily Credits Estimated",
          "type": "boolean"
        },
        "image_calls": {
          "default": 0,
          "title": "Image Calls",
          "type": "integer"
        },
        "cloudflare_images": {
          "default": 0,
          "title": "Cloudflare Images",
          "type": "integer"
        },
        "cloudflare_neurons": {
          "default": 0,
          "title": "Cloudflare Neurons",
          "type": "integer"
        },
        "pillow_cards": {
          "default": 0,
          "title": "Pillow Cards",
          "type": "integer"
        }
      },
      "title": "ExternalUsage",
      "type": "object"
    },
    "ImageResult": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "fallback_detail": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Detail"
        }
      },
      "required": [
        "slot_id",
        "path",
        "backend"
      ],
      "title": "ImageResult",
      "type": "object"
    },
    "ResearchPack": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "topic_name": {
          "title": "Topic Name",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRecord"
          },
          "title": "Sources",
          "type": "array"
        },
        "kb_allowed": {
          "default": false,
          "title": "Kb Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "slot_id",
        "topic_id",
        "topic_name",
        "sources"
      ],
      "title": "ResearchPack",
      "type": "object"
    },
    "ResolvedSlot": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "minLength": 1,
          "title": "Slot Id",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        },
        "angle_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle Source"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "service_line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Line"
        },
        "cta_allowed": {
          "default": true,
          "title": "Cta Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "slot_id",
        "type"
      ],
      "title": "ResolvedSlot",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "hard_fail": {
          "items": {
            "type": "string"
          },
          "title": "Hard Fail",
          "type": "array"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        }
      },
      "required": [
        "slot_id",
        "scores",
        "reasons",
        "hard_fail",
        "accepted"
      ],
      "title": "Review",
      "type": "object"
    },
    "RunSummary": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "slots": {
          "additionalProperties": {
            "$ref": "#/$defs/TerminalSlot"
          },
          "title": "Slots",
          "type": "object"
        },
        "shipped": {
          "title": "Shipped",
          "type": "integer"
        },
        "confirmed_tokens": {
          "title": "Confirmed Tokens",
          "type": "integer"
        },
        "uncertain_tokens": {
          "title": "Uncertain Tokens",
          "type": "integer"
        },
        "confirmed_cost_usd": {
          "title": "Confirmed Cost Usd",
          "type": "number"
        },
        "uncertain_cost_usd": {
          "title": "Uncertain Cost Usd",
          "type": "number"
        },
        "unpriced": {
          "title": "Unpriced",
          "type": "boolean"
        },
        "external_usage": {
          "$ref": "#/$defs/ExternalUsage"
        },
        "cost_scope": {
          "default": "LLM USD only; search/image calls counted but not priced. Pre-call token estimates can overshoot; uncertain dispatched charges retained.",
          "title": "Cost Scope",
          "type": "string"
        },
        "advisor": {
          "default": "not_enabled",
          "enum": [
            "not_enabled",
            "completed",
            "failed"
          ],
          "title": "Advisor",
          "type": "string"
        },
        "advisor_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advisor Reason"
        },
        "agents": {
          "additionalProperties": {
            "$ref": "#/$defs/AgentUsage"
          },
          "title": "Agents",
          "type": "object"
        }
      },
      "required": [
        "record_id",
        "slot_id",
        "attempt",
        "run_id",
        "slots",
        "shipped",
        "confirmed_tokens",
        "uncertain_tokens",
        "confirmed_cost_usd",
        "uncertain_cost_usd",
        "unpriced",
        "external_usage"
      ],
      "title": "RunSummary",
      "type": "object"
    },
    "SlotOutcome": {
      "enum": [
        "shipped",
        "dropped_quality",
        "failed_research",
        "failed_api",
        "failed_budget",
        "failed_output"
      ],
      "title": "SlotOutcome",
      "type": "string"
    },
    "SlotState": {
      "additionalProperties": false,
      "properties": {
        "slot": {
          "$ref": "#/$defs/ResolvedSlot"
        },
        "attempt": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "pack": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchPack"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/Draft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftAudit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/SlotOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "feedback": {
          "items": {
            "type": "string"
          },
          "title": "Feedback",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "slot"
      ],
      "title": "SlotState",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^(?:(?:SS|KB)-\\d+|STAT-\\d+|WEB-[a-f0-9]+)$",
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "kb",
            "stat",
            "web"
          ],
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "evidence_text": {
          "title": "Evidence Text",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "snippet_only",
            "fetch_failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title",
        "evidence_text"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "TerminalSlot": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/SlotOutcome"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Topic Id"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "outcome",
        "attempts",
        "topic_id",
        "reasons"
      ],
      "title": "TerminalSlot",
      "type": "object"
    },
    "Tweet": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "Tweet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "slots": {
      "additionalProperties": {
        "$ref": "#/$defs/SlotState"
      },
      "title": "Slots",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "advisor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Advisor"
    },
    "advisor_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Advisor Reason"
    }
  },
  "required": [
    "slots",
    "warnings"
  ],
  "title": "WeekSnapshot",
  "type": "object"
}
