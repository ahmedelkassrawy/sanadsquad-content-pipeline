{
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "snapshot_files": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Snapshot Files",
      "type": "object"
    },
    "marketing_week": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-W(?:0[1-9]|[1-4]\\d|5[0-3])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Marketing Week"
    }
  },
  "required": [
    "thread_id",
    "run_id",
    "snapshot_files"
  ],
  "title": "RunIdentity",
  "type": "object"
}
