{
  "$defs": {
    "ResearchPack": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "topic_name": {
          "title": "Topic Name",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRecord"
          },
          "title": "Sources",
          "type": "array"
        },
        "kb_allowed": {
          "default": false,
          "title": "Kb Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "slot_id",
        "topic_id",
        "topic_name",
        "sources"
      ],
      "title": "ResearchPack",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^(?:(?:SS|KB)-\\d+|STAT-\\d+|WEB-[a-f0-9]+)$",
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "kb",
            "stat",
            "web"
          ],
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "evidence_text": {
          "title": "Evidence Text",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "snippet_only",
            "fetch_failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title",
        "evidence_text"
      ],
      "title": "SourceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "slot_id": {
      "title": "Slot Id",
      "type": "string"
    },
    "attempt": {
      "title": "Attempt",
      "type": "integer"
    },
    "pack": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchPack"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "action": {
      "title": "Action",
      "type": "string"
    },
    "query": {
      "default": "",
      "title": "Query",
      "type": "string"
    },
    "query_attempts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Query Attempts",
      "type": "array"
    },
    "url_events": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Url Events",
      "type": "array"
    },
    "failure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    }
  },
  "required": [
    "record_id",
    "slot_id",
    "attempt",
    "evidence",
    "action"
  ],
  "title": "ResearchRecord",
  "type": "object"
}
