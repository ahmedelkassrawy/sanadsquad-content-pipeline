# Copy to .env and fill in only what you use. .env is ignored by git.
# Real environment variables override this file; command-line flags override both.
# Blank values are ignored and the default applies.

# ---- Run settings (all optional) ----
# Model used by every agent that does not set its own `model` in agents/<name>/agent.yaml.
# Format provider:model. The provider name decides which API key below is read.
DEFAULT_MODEL=openrouter:openai/gpt-4.1-mini
# If set, replaces the model of EVERY agent (including per-agent models in agent.yaml).
MODEL_OVERRIDE=
# If set (none, low, medium or high), replaces every agent's reasoning effort.
# Needed for models that reject reasoning_effort, for example mistralai:ministral-14b-latest.
REASONING_EFFORT_OVERRIDE=
# Editorial limit per tweet. It can only lower X's 280 limit, never raise it.
MAX_TWEET_CHARS=280
# Maximum model requests in flight at once for the run. Blank means no limit.
MAX_CONCURRENCY=
# Budget for the whole run, including the advisor. A call that does not fit is not started.
RUN_TOKEN_BUDGET=250000
RUN_COST_BUDGET_USD=1.00
# true lets models with no known price run (only the token budget then applies).
# Free models are unpriced (Mistral, NVIDIA); the committed Claude agents are priced.
ALLOW_UNPRICED=false
# false skips the advisor that suggests instruction edits after export.
ADVISOR_ENABLED=false

# ---- API keys: only for the providers your models use ----
# provider "openrouter" (the default model)
OPENROUTER_API_KEY=
# provider "nvidia" (free alternative for the reviewer and marketing writer; see README)
NVIDIA_API_KEY=
# provider "mistralai"
MISTRALAI_API_KEY=
# provider "groq"
GROQ_API_KEY=
# provider "google_genai"
GEMINI_API_KEY=
# provider "openai"
OPENAI_API_KEY=
# provider "anthropic" (paid; the committed thread_writer, marketing_writer and reviewer agent.yaml use it)
ANTHROPIC_API_KEY=
# provider "opencode"
OPENCODE_API_KEY=
# Any other LangChain provider reads <PROVIDER>_API_KEY, e.g. a provider "foo" reads FOO_API_KEY.

# ---- Web search (optional) ----
# With a key, research tries Tavily first. Without it, research uses DDGS, which needs no key.
TAVILY_API_KEY=

# Not read from this file: LangSmith tracing (LANGSMITH_TRACING, LANGSMITH_API_KEY) is read
# by LangChain from real environment variables only, because this project does not load
# .env into the environment.

# ---- Images (optional) ----
# Workers AI FLUX-schnell backgrounds; without both values, use the local Pillow card.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
