{
  "$defs": {
    "Draft": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "tweets": {
          "items": {
            "$ref": "#/$defs/Tweet"
          },
          "minItems": 1,
          "title": "Tweets",
          "type": "array"
        }
      },
      "required": [
        "slot_id",
        "tweets"
      ],
      "title": "Draft",
      "type": "object"
    },
    "Tweet": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "Tweet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "original": {
      "$ref": "#/$defs/Draft"
    },
    "normalized": {
      "$ref": "#/$defs/Draft"
    },
    "fixes": {
      "items": {
        "type": "string"
      },
      "title": "Fixes",
      "type": "array"
    },
    "violations": {
      "items": {
        "type": "string"
      },
      "title": "Violations",
      "type": "array"
    },
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    }
  },
  "required": [
    "original",
    "normalized",
    "fixes",
    "violations",
    "accepted"
  ],
  "title": "ValidationResult",
  "type": "object"
}
