          "type": "null"
        }
      ],
      "default": null
    },
    "failure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    }
  },
  "required": [
    "record_id",
    "slot_id",
    "attempt"
  ],
  "title": "ReviewRecord",
  "type": "object"
}
