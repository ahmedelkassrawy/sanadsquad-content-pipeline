          "type": "object"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "hard_fail": {
          "items": {
            "type": "string"
          },
          "title": "Hard Fail",
          "type": "array"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        }
      },
      "required": [
