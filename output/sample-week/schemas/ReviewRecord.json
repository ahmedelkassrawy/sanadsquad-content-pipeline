        "scores",
        "reasons",
        "hard_fail",
        "accepted"
      ],
      "title": "Review",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "slot_id": {
      "title": "Slot Id",
      "type": "string"
    },
    "attempt": {
      "title": "Attempt",
      "type": "integer"
    },
    "input_sha256": {
