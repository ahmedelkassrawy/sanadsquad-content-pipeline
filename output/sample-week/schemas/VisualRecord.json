{
  "$defs": {
    "ImageResult": {
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "fallback_detail": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Detail"
        }
      },
      "required": [
        "slot_id",
        "path",
        "backend"
      ],
      "title": "ImageResult",
      "type": "object"
    },
    "ImageSpec": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "title": "Concept",
          "type": "string"
        },
        "scene": {
          "title": "Scene",
          "type": "string"
        },
        "palette": {
          "items": {
            "type": "string"
          },
          "title": "Palette",
          "type": "array"
        },
        "overlay_text": {
          "title": "Overlay Text",
          "type": "string"
        },
        "alt_text": {
          "title": "Alt Text",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        }
      },
      "required": [
        "concept",
        "scene",
        "palette",
        "overlay_text",
        "alt_text"
      ],
      "title": "ImageSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "slot_id": {
      "title": "Slot Id",
      "type": "string"
    },
    "attempt": {
      "title": "Attempt",
      "type": "integer"
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Sha256"
    },
    "spec": {
      "$ref": "#/$defs/ImageSpec"
    },
    "result": {
      "$ref": "#/$defs/ImageResult"
    }
  },
  "required": [
    "record_id",
    "slot_id",
    "attempt",
    "spec",
    "result"
  ],
  "title": "VisualRecord",
  "type": "object"
}
